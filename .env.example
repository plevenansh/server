# Environment Configuration

# Node Environment
NODE_ENV=development

# Server Port (for production)
PORT=3000

# API Keys (if using paid tiers)
# THESPORTSDB_API_KEY=your_api_key_here
# ESPN_API_KEY=your_api_key_here

# Update Interval (in minutes)
UPDATE_INTERVAL_MINUTES=1

# Enable/Disable Scrapers
ENABLE_MOCK_SCRAPER=true
ENABLE_THESPORTSDB_SCRAPER=true
ENABLE_ESPN_SCRAPER=false
ENABLE_BBCSPORT_SCRAPER=false
